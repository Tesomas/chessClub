meta {
  name: Create player Bob Brooks
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/players
  body: json
  auth: none
}

body:json {
  {
    "firstName": "Bob",
    "lastName": "Brooks",
    "blitzElo": 1480,
    "rapidElo": 1450
  }
}

script:post-response {
  bru.setVar("pgBobId", res.getBody().id);
}

tests {
  test("returns 201 with an id", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().id).to.be.a("string").and.not.empty;
  });

  test("birthDate is echoed (null when omitted)", function() {
    expect(res.getBody().birthDate).to.equal(null);
  });
}
