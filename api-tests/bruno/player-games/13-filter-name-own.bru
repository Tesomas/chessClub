meta {
  name: Alice's own name is never matched
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/players/{{pgAliceId}}/games?opponentName=Anders
  body: none
  auth: none
}

tests {
  test("only the opponent side is searched", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().totalElements).to.equal(0);
  });
}
