meta {
  name: Reversed date range is rejected
  type: http
  seq: 21
}

get {
  url: {{baseUrl}}/api/players/{{pgAliceId}}/games?from=2026-10-05&to=2026-10-01
  body: none
  auth: none
}

tests {
  test("returns 400 ProblemDetail", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("content-type")).to.contain("application/problem+json");
    const body = res.getBody();
    expect(body.status).to.equal(400);
    expect(body.detail).to.contain("from must not be after to");
  });
}
