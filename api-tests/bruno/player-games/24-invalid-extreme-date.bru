meta {
  name: Extreme to date is rejected, not a 500
  type: http
  seq: 24
}

get {
  url: {{baseUrl}}/api/players/{{pgAliceId}}/games?to=%2B999999999-12-31
  body: none
  auth: none
}

tests {
  test("returns 400 ProblemDetail", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("content-type")).to.contain("application/problem+json");
    const body = res.getBody();
    expect(body.status).to.equal(400);
    expect(body.detail).to.contain("to must be between 1900-01-01 and 9999-12-31");
  });
}
