meta {
  name: Second page of size 3, oldest first
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/api/players/{{pgAliceId}}/games?size=3&page=1&sort=date&direction=asc
  body: none
  auth: none
}

tests {
  test("returns the partial last page with totals", function() {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.page).to.equal(1);
    expect(body.size).to.equal(3);
    expect(body.totalElements).to.equal(4);
    expect(body.totalPages).to.equal(2);
    expect(body.content.map((g) => g.date)).to.eql(["2026-10-04"]);
  });
}
