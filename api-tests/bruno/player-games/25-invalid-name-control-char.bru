meta {
  name: Control character in opponent name is rejected
  type: http
  seq: 25
}

get {
  url: {{baseUrl}}/api/players/{{pgAliceId}}/games?opponentName=bo%0Ab
  body: none
  auth: none
}

tests {
  test("returns 400 ProblemDetail", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("content-type")).to.contain("application/problem+json");
    const body = res.getBody();
    expect(body.status).to.equal(400);
    expect(body.detail).to.contain("opponentName must not contain control characters");
  });
}
