meta {
  name: List players contains created player
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/players
  body: none
  auth: none
}

tests {
  test("returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("includes the created player", function() {
    const ids = res.getBody().map((p) => p.id);
    expect(ids).to.include(bru.getVar("playerId"));
  });
}
