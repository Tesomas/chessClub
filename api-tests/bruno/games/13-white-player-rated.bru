meta {
  name: White player's rapid ELO reflects the game
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/players/{{whiteId}}
  body: none
  auth: none
}

tests {
  test("returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("rapid ELO was updated by the recorded game and other types were not", function() {
    const body = res.getBody();
    expect(body.firstName).to.equal("Magnus");
    expect(body.rapidElo).to.equal(2859);
    expect(body.blitzElo).to.equal(1200);
  });
}
