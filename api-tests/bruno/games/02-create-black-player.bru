meta {
  name: Create black player
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/players
  body: json
  auth: none
}

body:json {
  {
    "firstName": "Hikaru",
    "lastName": "Nakamura",
    "rapidElo": 2800
  }
}

script:post-response {
  bru.setVar("blackId", res.getBody().id);
}

tests {
  test("returns 201 with an id", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().id).to.be.a("string").and.not.empty;
  });
}
