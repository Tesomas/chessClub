meta {
  name: Update game with unknown player
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/api/games/{{gameId}}
  body: json
  auth: none
}

body:json {
  {
    "whitePlayerId": "{{whiteId}}",
    "blackPlayerId": "{{unknownId}}",
    "whitePlayerRating": 2850,
    "blackPlayerRating": 2800,
    "gameType": "RAPID",
    "result": "WHITE_WINS",
    "time": "10+0",
    "date": "2024-11-25",
    "pgn": "1. e4 *"
  }
}

tests {
  test("returns 404 ProblemDetail", function() {
    expect(res.getStatus()).to.equal(404);
    expect(res.getBody().status).to.equal(404);
    expect(res.getBody().detail).to.contain(bru.getEnvVar("unknownId"));
  });
}
