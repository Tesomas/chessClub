meta {
  name: Create game with a multi-line PGN
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/games
  body: json
  auth: none
}

body:json {
  {
    "whitePlayerId": "{{whiteId}}",
    "blackPlayerId": "{{blackId}}",
    "gameType": "CLASSICAL",
    "result": "WHITE_WINS",
    "time": "90+30",
    "date": "2024-11-27",
    "pgn": "[Event \"Club Championship\"]\n[Site \"ChessClub\"]\n[Date \"2024.11.27\"]\n[White \"Carlsen, Magnus\"]\n[Black \"Nakamura, Hikaru\"]\n[Result \"1-0\"]\n\n1. e4 e5 2. Nf3 d6 {Philidor's defence, \"solid\" but passive} 3. d4 Bg4\n4. dxe5 Bxf3 5. Qxf3 dxe5 6. Bc4 Nf6 7. Qb3 Qe7 8. Nc3 c6 9. Bg5 b5 {Zoë's\nfavourite blunder}\r\n10. Nxb5 cxb5 11. Bxb5+ Nbd7 12. O-O-O Rd8 13. Rxd7 Rxd7 14. Rd1 Qe6\n15. Bxd7+ Nxd7 16. Qb8+ Nxb8 17. Rd8# 1-0\n"
  }
}

script:post-response {
  bru.setVar("pgnGameId", res.getBody().id);
}

tests {
  test("returns 201 with an id", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().id).to.be.a("string").and.not.empty;
  });

  test("echoes the pgn unchanged", function() {
    expect(res.getBody().pgn).to.equal(req.getBody().pgn);
  });
}
