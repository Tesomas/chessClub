meta {
  name: Get game by id
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/games/{{gameId}}
  body: none
  auth: none
}

tests {
  test("returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns the created game", function() {
    const body = res.getBody();
    expect(body.id).to.equal(bru.getVar("gameId"));
    expect(body.pgn).to.equal("1. e4 e5 2. Nf3 Nc6 3. Bb5 *");
    expect(body.whitePlayerName).to.equal("Magnus Carlsen");
  });
}
