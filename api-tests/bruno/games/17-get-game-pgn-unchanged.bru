meta {
  name: Rejected update left the PGN unchanged
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/api/games/{{pgnGameId}}
  body: none
  auth: none
}

tests {
  test("still has the original multi-line pgn", function() {
    expect(res.getStatus()).to.equal(200);
    const pgn = res.getBody().pgn;
    expect(pgn.startsWith("[Event \"Club Championship\"]\n")).to.equal(true);
    expect(pgn.endsWith("17. Rd8# 1-0\n")).to.equal(true);
  });
}
